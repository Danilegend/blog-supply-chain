---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;              // absolute URL or path relative to public root
  ogType?: "website" | "article";
  articlePublishedTime?: string; // ISO 8601
}

const {
  title,
  description = "A blog about automation, DevOps, and AI workflows.",
  ogImage = "favicon.svg",
  ogType = "website",
  articlePublishedTime,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname;
const isHome = currentPath === `${base}/` || currentPath === base;
const isBlog = currentPath.startsWith(`${base}/blog`);

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const adsenseEnabled = Boolean(adsenseClient) && adsenseClient !== "ca-pub-xxxxxxxxxxxxxxxx";

// Canonical URL: full URL of current page
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// OG image: accept http(s) URL as-is; otherwise treat as path relative to public root
const ogImageURL = ogImage.startsWith("http")
  ? ogImage
  : Astro.site
    ? new URL(`${base}/${ogImage.replace(/^\//, "")}`, Astro.site).href
    : `${base}/${ogImage.replace(/^\//, "")}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (LinkedIn, Facebook, Slack, etc.) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Blog Supply Chain" />
    {articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {adsenseEnabled && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a href={`${base}/`} class="site-title">Blog Supply Chain</a>
        <nav>
          <a href={`${base}/`} class:list={[{ active: isHome }]}>Home</a>
          <a href={`${base}/blog/`} class:list={[{ active: isBlog }]}>Blog</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>© {new Date().getFullYear()} Blog Supply Chain</p>
        <p class="muted">
          Some posts contain affiliate links. If you buy through them, we may earn a commission at no extra cost to you.
        </p>
      </div>
    </footer>
  </body>
</html>
