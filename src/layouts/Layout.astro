---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A blog about automation, DevOps, and AI workflows.",
} = Astro.props;

// BASE_URL is "/blog-supply-chain/" with a trailing slash.
// Strip it once so we can build clean absolute paths.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" href={`${base}/favicon.ico`} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
