---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

type Post = CollectionEntry<'posts'>;

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a: Post, b: Post) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3); // Only grab the 3 most recent

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Blog Supply Chain | Automation & DevOps">
  <section class="hero">
    <div class="hero-badge">🤖 Automated Content Pipeline</div>
    <h1 class="hero-title">
      The <span class="text-gradient">Content Supply Chain</span> for Modern Devs
    </h1>
    <p class="hero-subtitle">
      A fully autonomous, AI-driven blog covering automation, DevOps, and AI workflows. 
      Written by Gemini, gated by human review, and deployed straight to the edge.
    </p>
    <div class="hero-actions">
      <a href={`${base}/blog/`} class="btn-primary">Explore all posts →</a>
    </div>
  </section>

  <section class="home-features">
    <div class="feature-card">
      <h3>⚡ Zero JS by default</h3>
      <p>Built on Astro for lightning-fast load times and perfect Lighthouse scores.</p>
    </div>
    <div class="feature-card">
      <h3>🧠 AI Generated</h3>
      <p>Drafts are researched and written using advanced Gemini language models.</p>
    </div>
    <div class="feature-card">
      <h3>🔒 Human Approved</h3>
      <p>Every post passes through a strict Telegram approval gate before publishing.</p>
    </div>
  </section>

  <section class="recent-section">
    <div class="recent-header">
      <h2>Latest Articles</h2>
      <a href={`${base}/blog/`}>View all →</a>
    </div>
    
    <div class="post-grid">
      {posts.map((post) => (
        <a href={`${base}/blog/${post.id}/`} class="post-card">
          <h2 class="post-card-title">{post.data.title}</h2>
          <p class="post-card-desc">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
