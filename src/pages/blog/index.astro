---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';

type Post = CollectionEntry<'posts'>;

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a: Post, b: Post) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Grab the newest post for the sidebar
const featuredPost = posts[0];
const otherPosts = posts.slice(1); 

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function readingTime(body: string | undefined): string {
  const words = (body ?? "").split(/\s+/).filter(Boolean).length;
  return `${Math.max(1, Math.round(words / 200))} min read`;
}
---

<Layout title="Blog | Blog Supply Chain" description="All posts on automation, DevOps, and AI workflows." wide={true}>
  <div class="blog-layout">
    
    <!-- Main Column -->
    <div class="blog-main">
      <header class="page-header">
        <h1>All Posts</h1>
        <p class="muted">Deep dives into AI automation, GitHub Actions, and modern DevOps.</p>
      </header>

      <AdSlot slot="blog-index-top" label="Advertisement" />

      <div class="post-grid">
        {otherPosts.map((post) => (
          <a href={`${base}/blog/${post.id}/`} class="post-card">
            <h2 class="post-card-title">{post.data.title}</h2>
            <p class="post-card-desc">{post.data.description}</p>
            <div class="post-card-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
              </time>
              <span>·</span>
              <span>{readingTime(post.body)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Sidebar -->
    <aside class="blog-sidebar">
      {featuredPost && (
        <div class="sidebar-widget featured-widget">
          <h3>⭐ Featured Post</h3>
          <h2>{featuredPost.data.title}</h2>
          <p>{featuredPost.data.description}</p>
          <a href={`${base}/blog/${featuredPost.id}/`}>Read article →</a>
        </div>
      )}

      <div class="sidebar-widget">
        <h3>About this Blog</h3>
        <p style="font-size: 0.9rem; color: var(--color-muted); margin: 0; line-height: 1.5;">
          This is a fully autonomous content pipeline. Drafts are generated by AI, approved via Telegram, and auto-deployed to GitHub Pages.
        </p>
      </div>

      <div class="sidebar-widget">
        <h3>Topics</h3>
        <ul class="topics-list">
          <li><a href="#">DevOps <span>12</span></a></li>
          <li><a href="#">AI Workflows <span>8</span></a></li>
          <li><a href="#">Astro <span>5</span></a></li>
          <li><a href="#">GitHub Actions <span>9</span></a></li>
        </ul>
      </div>
    </aside>

  </div>
</Layout>
