---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';

type Post = CollectionEntry<'posts'>;

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a: Post, b: Post) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function readingTime(body: string | undefined): string {
  const words = (body ?? "").split(/\s+/).filter(Boolean).length;
  const mins = Math.max(1, Math.round(words / 200));
  return `${mins} min read`;
}
---

<Layout title="Blog" description="All posts on automation, DevOps, and AI workflows.">
  <header class="page-header">
    <h1>Blog</h1>
    <p class="muted">{posts.length} post{posts.length === 1 ? "" : "s"}</p>
  </header>

  <AdSlot slot="blog-index-top" label="Advertisement" />

  <div class="post-grid">
    {posts.map((post) => (
      <a href={`${base}/blog/${post.id}/`} class="post-card">
        <h2 class="post-card-title">{post.data.title}</h2>
        <p class="post-card-desc">{post.data.description}</p>
        <div class="post-card-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString("en-US", {
              year: "numeric", month: "short", day: "numeric",
            })}
          </time>
          <span>·</span>
          <span>{readingTime(post.body)}</span>
        </div>
      </a>
    ))}
  </div>
</Layout>
