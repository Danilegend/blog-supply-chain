---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';

type Post = CollectionEntry<'posts'>;

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a: Post, b: Post) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 1. The absolute latest post goes to the Hero
const heroPost = posts[0];

// 2. The next 3 posts go into the grid under the hero
const gridPosts = posts.slice(1, 4);

// 3. The rest go into the sidebar timeline
const timelinePosts = posts.slice(4);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Fallback image in case a post was generated before we added Pexels
const fallbackImage = "https://images.pexels.com/photos/1181671/pexels-photo-1181671.jpeg?auto=compress&cs=tinysrgb&w=800";

function readingTime(body: string | undefined): string {
  const words = (body ?? "").split(/\s+/).filter(Boolean).length;
  return `${Math.max(1, Math.round(words / 200))} min read`;
}
---

<Layout title="Blog | Blog Supply Chain" description="All posts on automation, DevOps, and AI workflows." wide={true}>
  <div class="blog-layout">
    
    <!-- Main Column -->
    <div class="blog-main">
      
      <header class="page-header">
        <h1>Latest Insights</h1>
        <p class="muted">Deep dives into AI automation, GitHub Actions, and modern DevOps.</p>
      </header>

      <!-- 1. The Hero Post -->
      {heroPost && (
        <a href={`${base}/blog/${heroPost.id}/`} class="hero-post-card">
          <img src={heroPost.data.images?.[0] || fallbackImage} alt={heroPost.data.title} />
          <div class="hero-post-content">
            <h2 class="hero-post-title">{heroPost.data.title}</h2>
            <p class="hero-post-desc">{heroPost.data.description}</p>
            <div class="post-card-meta">
              <time datetime={heroPost.data.pubDate.toISOString()}>
                {heroPost.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
              </time>
              <span>·</span>
              <span>{readingTime(heroPost.body)}</span>
            </div>
          </div>
        </a>
      )}

      <!-- 2. The 3 Grid Cards -->
      <div class="post-grid" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
        {gridPosts.map((post) => (
          <a href={`${base}/blog/${post.id}/`} class="post-card">
            <div class="post-card-image-wrapper">
              <img src={post.data.images?.[0] || fallbackImage} alt={post.data.title} loading="lazy" />
            </div>
            <div class="post-card-content">
              <h3 class="post-card-title" style="font-size: 1.1rem;">{post.data.title}</h3>
              <div class="post-card-meta" style="margin-top:auto;">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                </time>
              </div>
            </div>
          </a>
        ))}
      </div>

      <AdSlot slot="blog-index-bottom" label="Advertisement" />
    </div>

    <!-- Sidebar -->
    <aside class="blog-sidebar">
      
      <!-- Vertical Timeline Widget -->
      <div class="sidebar-widget timeline-widget">
        <h3>More Articles</h3>
        <ul class="timeline-list">
          {timelinePosts.map((post) => (
            <li class="timeline-item">
              <a href={`${base}/blog/${post.id}/`} class="timeline-link">
                {post.data.title}
              </a>
              <time class="timeline-date" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
              </time>
            </li>
          ))}
        </ul>
      </div>

      <div class="sidebar-widget">
        <h3>About this Blog</h3>
        <p style="font-size: 0.9rem; color: var(--color-muted); margin: 0; line-height: 1.5;">
          This is a fully autonomous content pipeline. Drafts are generated by AI, approved via Telegram, and auto-deployed to GitHub Pages.
        </p>
      </div>

    </aside>

  </div>
</Layout>
